    def update_products_list(self):
        """Обновляет список продуктов"""
        self.products_listbox.delete(0, tk.END)
        
        # Фильтруем по поиску
        search = self.search_var.get().lower()
        products = [p for p in ALL_INGREDIENTS 
                   if not search or search in p.lower()]
        
        for product in sorted(products):
            if product in self.selected_ingredients:
                self.products_listbox.insert(tk.END, f"✓ {product}")
            else:
                self.products_listbox.insert(tk.END, f"  {product}")
    
    def add_selected(self):
        """Добавляет выбранные продукты"""
        selection = self.products_listbox.curselection()
        
        if not selection:
            messagebox.showinfo("Информация", "Выберите продукты из списка")
            return
        
        added = 0
        for index in selection:
            # Убираем префикс "✓ " или "  "
            item = self.products_listbox.get(index)[2:]
            if item not in self.selected_ingredients:
                self.selected_ingredients.add(item)
                added += 1
        
        if added > 0:
            self.update_selected_display()
            self.update_products_list()
            self.update_status(f"✅ Добавлено {added} продуктов")
        else:
            self.update_status("ℹ️ Продукты уже были выбраны")
    
    def update_selected_display(self):
        """Обновляет отображение выбранных продуктов"""
        if not self.selected_ingredients:
            self.selected_label.config(text="(нет выбранных продуктов)")
        else:
            products = sorted(list(self.selected_ingredients))
            text = " • ".join(products)
            self.selected_label.config(text=text)
    
    def clear_search(self):
        """Очищает поле поиска"""
        self.search_var.set("")
        self.update_products_list()
    
    def clear_selected(self):
        """Очищает все выбранные продукты"""
        self.selected_ingredients.clear()
        self.update_selected_display()
        self.update_products_list()
        self.recipes_listbox.delete(0, tk.END)
        self.update_status("🗑 Выбор очищен")
    
    def find_recipes(self):
        """Ищет рецепты по выбранным продуктам"""
        if not self.selected_ingredients:
            messagebox.showinfo("Информация", 
                "Сначала выберите продукты из списка слева")
            return
        
        # Ищем рецепты
        recipes = self.db.search_recipes(self.selected_ingredients)
        
        # Обновляем список
        self.recipes_listbox.delete(0, tk.END)
        
        if not recipes:
            self.recipes_listbox.insert(tk.END, 
                "😔 Рецепты не найдены. Попробуйте другие продукты.")
            self.update_status("❌ Рецепты не найдены")
        else:
            for recipe in recipes:
                match = int(recipe.match_percentage)
                self.recipes_listbox.insert(tk.END,
                    f"{recipe.name} [{match}%] - {recipe.category}")
            self.update_status(f"✅ Найдено {len(recipes)} рецептов")
    
    def show_recipe(self):
        """Показывает выбранный рецепт"""
        selection = self.recipes_listbox.curselection()
        
        if not selection:
            messagebox.showinfo("Информация", "Выберите рецепт из списка")
            return
        
        # Получаем название рецепта
        recipe_text = self.recipes_listbox.get(selection[0])
        
        if "Рецепты не найдены" in recipe_text:
            return
        
        # Извлекаем название (до [)
        recipe_name = recipe_text.split(' [')[0]
        
        # Ищем рецепт в базе
        self.db.cursor.execute(
            'SELECT * FROM recipes WHERE name = ?', (recipe_name,))
        recipe_data = self.db.cursor.fetchone()
        
        if recipe_data:
            self.show_recipe_details(recipe_data)
    
