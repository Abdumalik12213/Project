# ==================== КЛАССЫ ====================

@dataclass
class Recipe:
    """Модель рецепта"""
    id: int
    name: str
    ingredients: str
    instructions: str
    category: str
    prep_time: int
    difficulty: str
    match_percentage: float = 0.0
    matches: int = 0


class DatabaseManager:
    """Упрощенный менеджер базы данных"""
    
    def __init__(self, db_path: str):
        self.db_path = db_path
        self.conn = None
        self.cursor = None
    
    def connect(self):
        """Подключение к базе данных"""
        self.conn = sqlite3.connect(self.db_path)
        self.cursor = self.conn.cursor()
        return self
    
    def init_database(self):
        """Инициализация базы данных"""
        # Создаем таблицу
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS recipes (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            ingredients TEXT NOT NULL,
            instructions TEXT,
            category TEXT,
            prep_time INTEGER,
            difficulty TEXT
        )
        ''')
        
        # Очищаем таблицу
        self.cursor.execute('DELETE FROM recipes')
        
        # Загружаем рецепты
        for recipe in BASIC_RECIPES:
            self.cursor.execute('''
            INSERT INTO recipes (id, name, ingredients, instructions, category, prep_time, difficulty)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', recipe)
        
        self.conn.commit()
        print(f"✅ Загружено {len(BASIC_RECIPES)} рецептов")
        return self
    
    def search_recipes(self, selected_ingredients: Set[str]) -> List[Recipe]:
        """Поиск рецептов по ингредиентам"""
        if not selected_ingredients:
            return []
        
        self.cursor.execute('SELECT * FROM recipes')
        all_recipes = self.cursor.fetchall()
        
        results = []
        
        for row in all_recipes:
            recipe = Recipe(
                id=row[0],
                name=row[1],
                ingredients=row[2],
                instructions=row[3],
                category=row[4],
                prep_time=row[5],
                difficulty=row[6]
            )
            
            # Считаем совпадения
            recipe_ingredients = [ing.strip().lower() for ing in recipe.ingredients.split(',')]
            selected_lower = [ing.lower() for ing in selected_ingredients]
            
            matches = 0
            for selected in selected_lower:
                for recipe_ing in recipe_ingredients:
                    if selected in recipe_ing or recipe_ing in selected:
                        matches += 1
                        break
            
            if matches > 0:
                recipe.matches = matches
                recipe.match_percentage = (matches / len(recipe_ingredients)) * 100
                results.append(recipe)
        
        # Сортируем по проценту совпадения
        results.sort(key=lambda x: x.match_percentage, reverse=True)
        return results


